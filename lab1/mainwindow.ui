QLineEdit {
    font-size: 26px;
    font-weight: bold;
    padding: 10px;
    background: #ffffff;
    border: 2px solid #b5b5b5;
    border-radius: 6px;
}
QPushButton {
    font-size: 18px;
    min-height: 45px;
    background: #f7f7f7;
    border: 1px solid #b5b5b5;
    border-radius: 6px;
}
QPushButton:hover { background: #eaeaea; }
QPushButton:pressed { background: #d8d8d8; }
QPushButton#btnClear { background: #fdecea; }
QPushButton#btnClear:hover { background: #fbdcd8; }
QPushButton#btnAdd, QPushButton#btnSub, QPushButton#btnMul, QPushButton#btnDiv {
    background: #eaf1fb;
    font-size: 20px;
}
QPushButton#btnAdd:hover, QPushButton#btnSub:hover, QPushButton#btnMul:hover, QPushButton#btnDiv:hover {
    background: #dae7f8;
}
QPushButton#btnEqual {
    background: #4a90d9;
    color: #ffffff;
    font-size: 22px;
    font-weight: bold;
}
QPushButton#btnEqual:hover { background: #3f82c9; }
QPushButton#btnEqual:pressed { background: #3672b2; }
</string>
